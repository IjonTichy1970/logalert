# Claude Code: per-developer config and PROJECT skills stay local. The exceptions are the
# committed agent tooling -- the PreToolUse hook, its test (a gate stage), and the hook wiring --
# which CI and every clone must have. `.claude/*` (not `.claude/`) so the negations can apply.
.claude/*
!.claude/hooks/
!.claude/settings.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Scratch dir for reference material that must never be tracked
_review/

# The gate's captured output, as README.md tells a reader to write it
gate.out

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# The rendered changelog site (tools/render_changelog.py); built by the Pages workflow
site/
